{
  "permissions": {
    "allow": [
      "Workflow"
    ],
    "deny": [
      "Read(factory/holdout/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | grep -Eq 'factory/holdout|git push[^;&|]*(\\s-f\\b|--force|\\s\\+)|git push[^;&|]*[ :/]main(\\s|$|[;&|])' && { echo 'Blocked by factory policy.' >&2; exit 2; } || exit 0"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/factory-merge-guard.sh"
          }
        ]
      }
    ]
  }
}
